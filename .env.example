# TeleVault — environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Telegram API credentials ─────────────────────────────────────────────────
# Get these from https://my.telegram.org → "API development tools"
TG_API_ID=
TG_API_HASH=
TG_PHONE=          # International format, e.g. +1234567890

# ── Storage ───────────────────────────────────────────────────────────────────
# PostgreSQL is now the active database (see CHANGELOG - PostgreSQL migration).
# Default below matches docker-compose.yml's local dev service;
# override the host/user/password/db name if you're pointing at a different instance
# (e.g. a managed Postgres on your VPS instead of the bundled Docker Compose setup).
DATABASE_URL=postgresql+psycopg://televault:televault@localhost:5432/televault

# Separate database for the auth / multi-user "control" tables (accounts, invites, refresh tokens, audit log)
# - kept apart from the per-user archive database above (see control_db/schema.py for why).
# Same Postgres instance as DATABASE_URL by default, just a different database name.
CONTROL_DATABASE_URL=postgresql+psycopg://televault:televault@localhost:5432/televault_control

# ── Encryption ────────────────────────────────────────────────────────────────
# Symmetric key used to encrypt/decrypt the Telegram credential columns on `users`
# (telegram_api_id, telegram_api_hash, telegram_session_string) before they touch the control database.
# Required - there is no default (see config.py's Settings docstring for why).
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat it like a master password:
# back it up somewhere safe, never commit it - losing it makes every already-encrypted credential column permanently unreadable
# (there's no way to recover the plaintext without it).
FERNET_KEY=

# Secret used to SIGN (HMAC) JWT access/refresh tokens - separate from FERNET_KEY above
# (signing vs encryption are different operations; see config.py's Settings docstring for why they're kept independent).
# Required - no default. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Path to the OLD SQLite database file, if you have one from before the PostgreSQL migration.
# Only read by scripts/migrate_sqlite_to_postgres.py
# (the one-time data migration script) - not used anywhere else.
# Safe to leave at its default, or remove this line entirely, if you're starting fresh with no prior SQLite archive to migrate.
DB_PATH=data/televault.db

# Telethon saves your login session here as <SESSION_NAME>.session
# Change this only if you need multiple concurrent sessions (unusual).
SESSION_NAME=televault

# ── Logging ───────────────────────────────────────────────────────────────────
# Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Leave blank to log to console only (handy during local development).
# Set a path (e.g. logs/televault.log) to also write rotating log files.
LOG_FILE=