# TeleVault - environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Storage ───────────────────────────────────────────────────────────────────
# The control database: accounts, invites, refresh tokens, audit log - and, encrypted, every account's Telegram credentials and login session.
# Default below matches docker-compose.yml's local dev Postgres service;
# override host/user/password/db name if you're pointing at a different instance (e.g. a managed Postgres on your VPS).
#
# Each account's own archive database is created automatically (from the web UI's setup wizard) on THIS SAME server with THESE SAME credentials,
# so there is no second connection string.
# The Postgres role needs the CREATEDB privilege for that (the docker-compose one has it).
#
# There are deliberately NO Telegram settings (api_id / api_hash / phone) in this file: every account enters its own in the web UI
# (Settings -> Telegram setup) and they are stored encrypted in this database.
CONTROL_DATABASE_URL=postgresql+psycopg://televault:televault@localhost:5432/televault_control

# ── Encryption ────────────────────────────────────────────────────────────────
# Symmetric key used to encrypt/decrypt the Telegram credential columns on `users`
# (telegram_api_id, telegram_api_hash, telegram_session_string) before they touch the control database.
# Required - there is no default (see config.py's Settings docstring for why).
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat it like a master password:
# back it up somewhere safe, never commit it - losing it makes every already-encrypted credential column permanently unreadable
# (there's no way to recover the plaintext without it).
FERNET_KEY=

# Secret used to SIGN (HMAC) JWT access/refresh tokens - separate from FERNET_KEY above
# (signing vs encryption are different operations; see config.py's Settings docstring for why they're kept independent).
# Required - no default. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# One-time token that lets the FIRST person to register (via the ordinary web UI/POST /auth/register, with this exact value as their invite code)
# become TeleVault's one-and-only admin account - see config.py's Settings.bootstrap_admin_token docstring for the chicken-and-egg problem this solves.
# Needed on a fresh instance UNLESS you create the admin from a shell instead (scripts/manage_admin.py's `create` subcommand):
# the API server refuses to start while there is no admin account AND this is blank - otherwise nobody could ever register.
# Once an admin exists you may leave it blank.
# Pick your own random phrase;
# generating one is just as reasonable as the FERNET_KEY/JWT_SECRET commands above:
#   openssl rand -hex 16
# Works exactly ONCE per instance: the moment an admin account exists,
# this value is permanently inert for this purpose (see control_db.queries.admin_exists()) - safe to leave it in .env afterward, or remove it.
TELEVAULT_BOOTSTRAP_ADMIN_TOKEN=

# ── API docs ──────────────────────────────────────────────────────────────────
# Serve the interactive API docs (/api/docs, /api/redoc) and /api/openapi.json?
# Leave false (the default) on any instance other people can reach - they publish a full map of every endpoint.
# Set to true on your own machine while developing/testing endpoints by hand.
ENABLE_API_DOCS=false

# Where per-account runtime files (archiver heartbeat, backfill status) are kept.
# Optional.
# A relative path is resolved against the repo root.
# Must be writable by the API server (which also starts the workers).
# DATA_DIR=data

# ── Logging ───────────────────────────────────────────────────────────────────
# Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Leave blank to log to console only (handy during local development).
# Set a path (e.g. logs/televault.log) to also write rotating log files.
LOG_FILE=